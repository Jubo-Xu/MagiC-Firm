        <mxCell id="e2" value="is_finish &amp;amp; ~drain_done:&lt;br&gt;ride FINISH down once&lt;br&gt;(ORIGIN: emit EV_FINISH)" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=1.4;edgeStyle=none;curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_exec" target="s_drain">
          <mxGeometry relative="1" as="geometry">
