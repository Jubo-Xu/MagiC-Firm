        <mxCell id="e8" value="en &amp;amp; wt == 0 &amp;amp; start == end:&lt;br&gt;single read, one_instr_end = 1" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=1.4;edgeStyle=none;curved=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_idle" target="d_idle">
