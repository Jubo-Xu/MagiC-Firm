              <mxPoint x="625" y="290"/>
              <mxPoint x="190" y="290"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="en &amp;amp; wt ≠ 0: latch start/end,&lt;br&gt;wcnt ← wt − 1" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=1.4;edgeStyle=none;curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_idle" target="d_wait">
          <mxGeometry relative="1" as="geometry">
