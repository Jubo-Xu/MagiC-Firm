<mxfile host="MagiC-Firm/gen_arch_figures.py" version="24.7.0" type="device">
  <diagram id="page6" name="06_root_output_sync">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="830" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="&lt;b&gt;RootOutputSync — root output path (RootOutputSync.sv)&lt;/b&gt;&lt;br&gt;wraps OutputSync and stamps every emitted det-time word with stim global detector indices and round markers for the host / decoder" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1250" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ro" value="&lt;b&gt;RootOutputSync  #(D, D_FIFO, PC_W, INDEX_W, HW_WIDTH, STRIDE, SENTINEL, SAT_PC)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FAFAFA;strokeColor=#7A7A7A;rounded=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="1080" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="p_d" value="in_det / in_valid / in_finish [D]&lt;br&gt;(= d_out bus: pass ++ construct)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p_sm" value="sync_mask [D]  @ pc" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="180" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p_gi" value="global_indexes [D × INDEX_W]  @ pc" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="400" width="180" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p_rm" value="round_marker [3]  @ pc&lt;br&gt;{is_first_normal, is_last_normal, is_wait}" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="470" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="os" value="&lt;b&gt;OutputSync  (see 05)&lt;/b&gt;&lt;br&gt;per-line FIFOs · ready · pc&lt;br&gt;→ out_det, out_used, out_valid, out_finish" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="110" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="mk" value="round markers (aligned with out_det)&lt;br&gt;first_normal = valid &amp;amp; rm_reg[0]&lt;br&gt;last_normal  = valid &amp;amp; rm_reg[1]&lt;br&gt;first_wait   = valid &amp;amp; rm_reg[2] &amp;amp; ~is_wait_q&lt;br&gt;last_wait    = valid &amp;amp; rm_reg[2] &amp;amp; finish" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="230" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="align" value="1-cycle alignment registers&lt;br&gt;gi_reg ← global_indexes&lt;br&gt;rm_reg ← round_marker&lt;br&gt;pc_reg ← sync_regfile_pc&lt;br&gt;(line up with OutputSync's registered out_det)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#EDEDED;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="380" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="gidx" value="per line l:&lt;br&gt;idx = gi_reg[l]&lt;br&gt;used = out_valid &amp;amp; out_used[l]&lt;br&gt;out_global_indexes[l] =&lt;br&gt;  (used &amp;amp;&amp;amp; idx != SENTINEL)&lt;br&gt;    ? zext(idx) + offset&lt;br&gt;    : all-ones  (HW_WIDTH)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="380" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="wcnt" value="wait counter w&lt;br&gt;sat_here = SAT_EN &amp;amp; (pc_reg == SAT_PC)&lt;br&gt;if out_valid &amp;amp; sat_here: w ← w + 1&lt;br&gt;is_wait_q ← rm_reg[2] on each valid" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#EDEDED;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="520" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="off" value="offset = sat_here ? w × STRIDE : 0&lt;br&gt;(each repeated copy-last wait round&lt;br&gt;gets a fresh detector-number block)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="570" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="nt" value="The host / decoder consumes (out_det, out_global_indexes) per det-time; first_normal / last_normal / first_wait /&lt;br&gt;last_wait tell the control core where the normal rounds end and the (repeated) wait rounds begin and end." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="690" width="900" height="40" as="geometry"/>
