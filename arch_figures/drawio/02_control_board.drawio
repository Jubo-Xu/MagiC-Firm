        <mxCell id="evmux" value="&lt;b&gt;Event-source select&lt;/b&gt;&lt;br&gt;root: start/finish → EV_START / EV_FINISH&lt;br&gt;non-root: relay ev_* from parent  (= bc_ev)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
