        </mxCell>
        <mxCell id="bcast" value="&lt;b&gt;Single-finish broadcast&lt;/b&gt;&lt;br&gt;child c's one finish bit → every line in&lt;br&gt;[base(c), base(c)+CHILD_DW/RAW[c])  (prefix sums)&lt;br&gt;leaf: in_meas_finish passes straight" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
