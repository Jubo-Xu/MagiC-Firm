        </mxCell>
        <mxCell id="mmiomux" value="&lt;b&gt;MMIO event source&lt;/b&gt;&lt;br&gt;ORIGINATE: BoardControl.out_ev (registered,&lt;br&gt;carries the internal ABORT)&lt;br&gt;FORWARD: bc_ev (received from parent)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="690" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="bc" value="&lt;b&gt;BoardControl  (attempt / event FSM)  →  08_board_control&lt;/b&gt;&lt;br&gt;IDLE → EXEC → DRAIN;  abort = |(post_select &amp;amp; (ps_att XNOR attempt))&lt;br&gt;1-bit attempt: START → 0; abort flips it (ORIGINATE) /&lt;br&gt;adopts ev_attempt (FORWARD); stale data = tag mismatch → dropped&lt;br&gt;out: reset, set_in_data_to_zero, out_ev_*, out_attempt, discard" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#E6F4EA;strokeColor=#2E7D32;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="570" y="100" width="410" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="dcb" value="&lt;b&gt;DetectorConstructBlock (DCB)  →  03_detector_construct_block&lt;/b&gt;&lt;br&gt;rst = board_reset (local: rst | abort | finish)&lt;br&gt;raw path: RawSelector → fwd_raw&lt;br&gt;construct path: MeasurementSync → K Kernels&lt;br&gt;pass path: DetectorPass&lt;br&gt;d_out = pass ++ construct&lt;br&gt;OutputSync / RootOutputSync (+ global index, markers)&lt;br&gt;Postselect (HAS_PS) → post_select" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
