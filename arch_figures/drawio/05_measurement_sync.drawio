<mxfile host="MagiC-Firm/gen_arch_figures.py" version="24.7.0" type="device">
  <diagram id="page5" name="05_measurement_sync">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="&lt;b&gt;MeasurementSync (M raw lines) / OutputSync (D detector lines) — identical logic (MeasurementSync.sv, OutputSync.sv)&lt;/b&gt;&lt;br&gt;asynchronously arriving per-line values are re-aligned into one word per meas-time / det-time, driven by a compiled mask program" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1250" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ms" value="&lt;b&gt;MeasurementSync  #(M, D_FIFO, PC_W, SAT_PC)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FAFAFA;strokeColor=#7A7A7A;rounded=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="1060" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="p_mask" value="sync_mask [M]&lt;br&gt;(regfile word @ pc)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p_i" value="in_meas[i] / in_valid[i] / in_finish[i]&lt;br&gt;(one per line, arrive in any cycle)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="rf" value="&lt;b&gt;sync regfile  (RegFileROM, in the parent DCB)&lt;/b&gt;&lt;br&gt;row pc → mask: which lines this&lt;br&gt;meas-time needs" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="110" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pc" value="pc register&lt;br&gt;if ready: pc ← (SAT_EN &amp;amp;&amp;amp; pc+1 &amp;gt; SAT_PC)&lt;br&gt;                  ? SAT_PC : pc + 1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#EDEDED;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lane" value="&lt;b&gt;line i  (replicated M times)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#F1F1F1;strokeColor=#9A9A9A;rounded=1;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="220" width="720" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="fifo" value="&lt;b&gt;FIFO_i  (D_FIFO × {value, finish})&lt;/b&gt;&lt;br&gt;head / tail / count&lt;br&gt;push: in_valid[i] &amp;amp; ~bypass&lt;br&gt;pop:  ready &amp;amp; from_fifo[i]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#E3F0FB;strokeColor=#1F5FA8;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="270" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="src" value="source mux&lt;br&gt;from_fifo[i] = mask[i] &amp;amp; ~empty[i]&lt;br&gt;bypass_sel[i] = mask[i] &amp;amp; empty[i] &amp;amp; in_valid[i]&lt;br&gt;value = from_fifo ? head : in_meas[i]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="260" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="avail" value="avail[i] = ~mask[i] | from_fifo[i]&lt;br&gt;               | bypass_sel[i]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="375" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ovf" value="overflow check (sim): want_push &amp;amp; full" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="270" y="390" width="230" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="lane2" value="&lt;b&gt;line i+1 …&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#F1F1F1;strokeColor=#9A9A9A;rounded=1;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="480" width="720" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="laneM" value="&lt;b&gt;line M−1&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#F1F1F1;strokeColor=#9A9A9A;rounded=1;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="525" width="720" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ready" value="ready = AND over all lines of avail[i]&lt;br&gt;(all-zero mask ⇒ trivially ready:&lt;br&gt;emit all-0 and advance = fast-forward)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="300" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="oreg" value="output register (1 pulse per accepted step)&lt;br&gt;out_meas[i] ← mask[i] ? value_i : 0&lt;br&gt;out_used ← mask&lt;br&gt;out_valid ← ready&lt;br&gt;out_finish ← OR over used lines of&lt;br&gt;   (from_fifo ? head_finish : in_finish[i])" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#EDEDED;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="400" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="nt" value="Invariant used by the compiler: a meas-time with an all-0 sync mask has all-0 core words, so one shared pc clocks both&lt;br&gt;MeasurementSync and every Kernel; with copy-last the appended wait row saturates the pc so the last round repeats." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="250" y="600" width="900" height="40" as="geometry"/>
