<mxfile host="MagiC-Firm/gen_arch_figures.py" version="24.7.0" type="device">
  <diagram id="page11" name="11_stim_readout_loop">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="630" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="&lt;b&gt;StimReadout — synthesizable measurement-readout stand-in for hardware-in-the-loop stim tests (StimReadout.sv)&lt;/b&gt;&lt;br&gt;replays RECORDED measurements from BRAM back into a leaf ControlBoard; closes the mmio_out → readout → in_meas loop" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1250" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="leaf" value="&lt;b&gt;Leaf ControlBoard  (FORWARD · INTERNAL)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FAFAFA;strokeColor=#7A7A7A;rounded=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="420" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="lbc" value="&lt;b&gt;BoardControl&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#E6F4EA;strokeColor=#2E7D32;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="160" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lmm" value="&lt;b&gt;PhysicalMMIO  (P = 1)&lt;/b&gt;&lt;br&gt;out_data = ROUND INDEX&lt;br&gt;(sim CW type: entry = its index)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="250" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ldcb" value="&lt;b&gt;DetectorConstructBlock&lt;/b&gt;&lt;br&gt;in_meas / in_valid / in_meas_finish" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="90" y="370" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lo" value="fwd_det / fwd_raw … → parent" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="115" width="160" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="sr" value="&lt;b&gt;StimReadout  #(M, SHOTS, DEPTH, MEAS_FILE, VALID_FILE)  — GLOBAL rst + cw_gen_finish, never board_reset&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FAFAFA;strokeColor=#7A7A7A;rounded=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="760" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="shot" value="shot_q / base_q registers&lt;br&gt;reset | cw_gen_finish : shot ← 0, base ← 0&lt;br&gt;EV_ABORT (guarded shot+1 &amp;lt; SHOTS):&lt;br&gt;   shot ← shot+1, base ← (shot+1) × DEPTH&lt;br&gt;(pointer moves in LOCKSTEP across all leaves —&lt;br&gt; the abort is global and in sync)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#EDEDED;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="140" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="addr" value="addr = base_q + mmio_out_data&lt;br&gt;rom_addr = active ? addr : 0&lt;br&gt;active = mmio_out_valid &amp;amp; ~rst" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="150" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="romm" value="&lt;b&gt;SyncROM  meas  (BRAM)&lt;/b&gt;&lt;br&gt;SHOTS × DEPTH rows × M bits&lt;br&gt;shot-major · sim_readout_meas.mem" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="250" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="romv" value="&lt;b&gt;SyncROM  valid  (BRAM)&lt;/b&gt;&lt;br&gt;same layout&lt;br&gt;sim_readout_valid.mem" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1160" y="250" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="fin" value="finish_q ← mmio_out_valid &amp;amp; cw_gen_finish&lt;br&gt;(aligned with the 1-cycle BRAM read)&lt;br&gt;out_meas_finish = finish_q ? valid_data : 0" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#EDEDED;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="300" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="nt" value="The ABORT that advances the readout is the SAME event that restarts the CW program in BoardControl / PhysicalMMIO, so a rejected shot is&lt;br&gt;discarded everywhere on the same cycle. Multi-shot / multi-trial tests (test_control_board_stim, tb_ControlBoard) drive only the root's start / finish / gap_post_select." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="1300" height="50" as="geometry"/>
        </mxCell>
