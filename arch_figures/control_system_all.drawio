        <mxCell id="da_n" value="Fires one cycle after the LAST input arrives. Router-side drain aggregation is retired:&lt;br&gt;subtree drain now rides the DATA path (DCB det out_finish)." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
