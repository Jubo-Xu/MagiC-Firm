  <diagram id="page9" name="09_physical_mmio">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="&lt;b&gt;PhysicalMMIO — command-word generator for one physical control core (PhysicalMMIO.sv)&lt;/b&gt;&lt;br&gt;one per control core on a leaf (P per board); turns the board's events into a stream of command words; program = instruction regfile + CW memory" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1250" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="mm" value="&lt;b&gt;PhysicalMMIO  #(INSTR_DEPTH, CW_DEPTH, DATA_W, WT_W, INSTR_FILE, CW_FILE)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FAFAFA;strokeColor=#7A7A7A;rounded=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="1060" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="p_ev" value="ev_valid / ev_type / ev_payload&lt;br&gt;(board event source)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p_rst" value="clk / rst  (system reset)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="180" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="seq" value="&lt;b&gt;InstrSequencer  (FSM)  →  10_instr_fsms&lt;/b&gt;&lt;br&gt;IDLE / EXEC / DRAIN&lt;br&gt;owns instruction pointer ptr (saturates at&lt;br&gt;DEPTH−1 = the compiled WAIT instruction)&lt;br&gt;registers instr_en / instr_addr (no-stall handoff)&lt;br&gt;rst_out = rst | is_abort | rst_for_finish" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#E6F4EA;strokeColor=#2E7D32;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="110" width="330" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="irf" value="&lt;b&gt;Instruction regfile  (RegFileROM, async → LUTRAM)&lt;/b&gt;&lt;br&gt;INSTR_DEPTH × INSTR_W  ·  MMIO_instr_&amp;lt;p&amp;gt;.mem" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="330" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="unp" value="InstrUnpack  (pure combinational)&lt;br&gt;splits the packed word — the ONLY place&lt;br&gt;that knows the instruction encoding" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="210" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="w_wt" value="wt  [WT_W]&lt;br&gt;idle cycles before 1st read" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="300" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="w_st" value="start_addr  [ADDR_W]&lt;br&gt;first CW address" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="850" y="300" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="w_en" value="end_addr  [ADDR_W]&lt;br&gt;last CW address" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="300" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="w_n" value="INSTR_W = 2·ADDR_W + WT_W   (MSB … LSB)" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="720" y="345" width="340" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="dec" value="&lt;b&gt;InstrDecode  (Mealy FSM)  →  10_instr_fsms&lt;/b&gt;&lt;br&gt;IDLE / WAITC / STREAM&lt;br&gt;wait wt idle cycles, then r_addr = start … end&lt;br&gt;(one per cycle, r_en high); one_instr_end on&lt;br&gt;the cycle r_addr == end" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#E6F4EA;strokeColor=#2E7D32;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="320" width="330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="cw" value="&lt;b&gt;Command-word memory  (SyncROM, 1-cycle → BRAM)&lt;/b&gt;&lt;br&gt;CW_DEPTH × DATA_W  ·  MMIO_cw_&amp;lt;p&amp;gt;.mem&lt;br&gt;NO reset by design: the last word of a finishing&lt;br&gt;instruction is still delivered" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="500" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="nt" value="Output contract: out_valid alone says 'there is a command this cycle'; when low, out_data = 0 and the core does nothing —&lt;br&gt;idle cycles cost no CW memory.  Critical path (combinational, by design of the zero-stall handoff):&lt;br&gt;InstrSequencer regs → instr_addr mux → instruction regfile (async) → InstrUnpack → InstrDecode → CW memory address." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="640" y="460" width="620" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="nt2" value="Abort handling: EV_ABORT restarts the program from instruction 0 (rst_out clears InstrDecode the same cycle);&lt;br&gt;EV_FINISH lets the in-flight instruction drain, then cw_gen_finish pulses in the SAME cycle as the final out_valid." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="640" y="560" width="620" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="o_d" value="out_data [DATA_W]&lt;br&gt;out_valid → physical control core" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1310" y="520" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="o_f" value="cw_gen_finish&lt;br&gt;→ board (1-cycle pulse)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1310" y="160" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_ev" target="seq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#6A1B9A;strokeWidth=1.3;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_rst" target="seq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="instr_en,&lt;br&gt;instr_addr" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#8A6D00;strokeWidth=1.3;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq" target="irf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="instr_word [INSTR_W]" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#8A6D00;strokeWidth=1.3;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="irf" target="unp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="wt, start_addr, end_addr" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#8A6D00;strokeWidth=1.3;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="unp" target="dec">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="245"/>
              <mxPoint x="640" y="358"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="en = instr_en" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq" target="dec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="rst_out (single reset source)" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#6A1B9A;strokeWidth=1.3;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq" target="dec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="one_instr_end" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="seq">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="235" y="375"/>
              <mxPoint x="235" y="233"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="r_en, r_addr [ADDR_W]" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#8A6D00;strokeWidth=1.3;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="cw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="data / data_valid (1 cycle later)" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cw" target="o_d">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="cw_gen_finish = rst_for_finish" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq" target="o_f">
          <mxGeometry relative="1" as="geometry">
