  <diagram id="page2" name="02_control_board">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="990" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="&lt;b&gt;ControlBoard — the universal per-board wrapper (rtl/src/control_system/ControlBoard.sv)&lt;/b&gt;&lt;br&gt;One parameterized module for leaf / router / stage / root / monolithic; all board-to-board glue lives here" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cb" value="&lt;b&gt;ControlBoard  #(IS_ROOT, IS_LEAF, EVENT_MODE, DATA_SRC, HAS_PS, NCHILD, CHILD_DW[], CHILD_RAW[], NPS, P, M, D_IN, K, N, H, RAW_OUT, …)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FAFAFA;strokeColor=#7A7A7A;rounded=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="1120" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="p_ev" value="ev_valid / ev_type / ev_payload /&lt;br&gt;ev_attempt   (from parent)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p_host" value="start / finish   (host, root)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="175" width="180" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p_gap" value="gap_post_select   (host, root)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="180" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p_psin" value="ps_in / ps_in_attempt [NPS]&lt;br&gt;(stage boards, root)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="265" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p_att" value="in_child_attempt [NCHILD]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="340" width="180" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p_det" value="in_det / in_det_valid [D_IN]&lt;br&gt;(children, concatenated)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="405" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p_meas" value="in_meas / in_meas_valid [M]&lt;br&gt;(children raw  |  leaf: readout)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="455" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p_fin" value="in_det_finish_child /&lt;br&gt;in_raw_finish_child [NCHILD]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="520" width="180" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p_mfin" value="in_meas_finish [M]   (leaf)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="575" width="180" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p_clk" value="clk / rst   (system)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="890" width="180" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="evmux" value="&lt;b&gt;Event-source select&lt;/b&gt;&lt;br&gt;root: start/finish → EV_START / EV_FINISH&lt;br&gt;non-root: relay ev_* from parent  (= bc_ev)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="110" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="psasm" value="&lt;b&gt;Post-select bus assembly (root)&lt;/b&gt;&lt;br&gt;bc_ps = [ own DCB ps | ps_in[0..NPS) | gap ]&lt;br&gt;own + gap slots stamped with cur_attempt" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="210" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="attor" value="&lt;b&gt;Input status&lt;/b&gt;&lt;br&gt;bc_in_valid = |in_det_valid  |  |in_meas_valid&lt;br&gt;bc_data_attempt = |in_child_attempt" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
