        </mxCell>
        <mxCell id="sel" value="&lt;b&gt;Selector&lt;/b&gt;&lt;br&gt;N index muxes over the M lines&lt;br&gt;b_m[j] = in_valid &amp;amp; in_used[idx_j]&lt;br&gt;            &amp;amp; in_meas[idx_j]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="130" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cml" value="core_mask word layout (LSB = bit 0):" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="640" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="cm_h" value="core H−1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
