  <diagram id="page1" name="01_compiler_toolchain">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1330" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="&lt;b&gt;Compiler toolchain (hardware/compiler/control_system)&lt;/b&gt;&lt;br&gt;stim circuit + hardware config → per-board regfiles / MMIO programs / simulation vectors; validated against stim" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="in1" value="&lt;b&gt;stim circuit (.stim)&lt;/b&gt;&lt;br&gt;QEC / magic-state cultivation" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="in2" value="&lt;b&gt;hardware config (.json)&lt;/b&gt;&lt;br&gt;layers · boards · kernels {n,h} · raw_out&lt;br&gt;+ postselect detector set" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="170" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="parser" value="&lt;b&gt;parser.py — DetectorConstructionScanner&lt;/b&gt;&lt;br&gt;scan() → refine()&lt;br&gt;det_idx = stim detector index&lt;br&gt;channels = spatial coords, windows, stages" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="290" y="80" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="config" value="&lt;b&gt;config.py — CompilerConfig&lt;/b&gt;&lt;br&gt;board tree, path_to_root, lca&lt;br&gt;postselect set (explicit indices)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="290" y="180" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="place" value="&lt;b&gt;placement.py — Placement&lt;/b&gt;&lt;br&gt;channel → LCA of its support (Option B)&lt;br&gt;forwarding (normal + obs), stage boards" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="comp" value="&lt;b&gt;compiler.py — Compiler (pure library)&lt;/b&gt;&lt;br&gt;mask generation → BoardProgram,&lt;br&gt;KernelProgram, DetectorOutput&lt;br&gt;core index = emission rank mod h" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="120" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ser" value="&lt;b&gt;serializer.py — Serializer  (PHYSICAL-port layout)&lt;/b&gt;&lt;br&gt;board&amp;lt;i&amp;gt;/{json,mem}: qubit_scope (leaf), sync, k&amp;lt;i&amp;gt;_selector,&lt;br&gt;k&amp;lt;i&amp;gt;_core, raw_selector[_obs], output_sync, global_index,&lt;br&gt;round_marker, postselect (stage) · connections.json&lt;br&gt;measurement_map.json · manifest.json · report.txt" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="260" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="icw" value="&lt;b&gt;gen_instr_cw.py  (Phase B)&lt;/b&gt;&lt;br&gt;MMIO_instr_&amp;lt;p&amp;gt;.mem / MMIO_cw_&amp;lt;p&amp;gt;.mem per core&lt;br&gt;wt = inter-measurement time / clock period" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="400" width="360" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sim" value="&lt;b&gt;gen_sim.py  (Phase C)&lt;/b&gt;&lt;br&gt;stim samples → in_meas / in_valid (DCB layout),&lt;br&gt;sim_readout_meas / valid (StimReadout layout),&lt;br&gt;expected_dets, expected_postselect" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="500" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;cli.py — front door&lt;/b&gt;&lt;br&gt;orchestrates stages 1–3 (drives Compiler + Serializer)&lt;br&gt;--wait-rounds · --wait-row copy-last&lt;br&gt;--postselect-layout · --output-sync" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="610" y="260" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="val" value="&lt;b&gt;Validation vs stim&lt;/b&gt;&lt;br&gt;test_harness.py: in-memory compiler&lt;br&gt;validate_serialized.py: round-trip from files&lt;br&gt;10 topologies × 2 circuits, 0 mismatches" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
