          <mxGeometry x="260" y="560" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="nt" value="Why this shape: a detector = XOR of measurements spread over several meas-times. Each core accumulates one&lt;br&gt;detector window; the compiler assigns core index = emission rank mod H so windows sharing a core never overlap." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
