        <mxCell id="p_cm" value="core_mask [H(N+1)]&lt;br&gt;(k&amp;lt;i&amp;gt;_core.mem @ core_regfile_pc)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
