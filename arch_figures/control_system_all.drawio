            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="addr == end: r_en = 1, r_addr = end, one_instr_end = 1  (→ sequencer registers the next instruction)" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=1.4;edgeStyle=none;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_str" target="d_idle">
          <mxGeometry relative="1" as="geometry">
