          <mxGeometry x="560" y="120" width="420" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="and0" value="AND&lt;br&gt;sel_0 &amp;amp; b_m" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="170" width="90" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="xor0" value="XOR tree&lt;br&gt;res = ^(sel_0 &amp;amp; b_m)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
