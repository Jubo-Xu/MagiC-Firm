        <mxCell id="cm_1" value="core 1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="665" width="90" height="30" as="geometry"/>
