        <mxCell id="fpga" value="&lt;b&gt;FPGA synthesis (Vivado)&lt;/b&gt;&lt;br&gt;$readmemb → LUTRAM (RegFileROM)&lt;br&gt;/ BRAM (SyncROM) INIT strings" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1A1A1A;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
