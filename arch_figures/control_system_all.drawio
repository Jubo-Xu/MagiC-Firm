  <diagram id="page12" name="12_memory_primitives">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1370" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="&lt;b&gt;Memory primitives (rtl/src/lib, emulator/include/lib) — every compiled program is a .mem file loaded by $readmemb / $readmemh&lt;/b&gt;&lt;br&gt;file format: one word per line, MSB-first, LSB = bit 0 — parsed identically by the SystemC load_mem_file() and by the RTL, baked into LUTRAM / BRAM INIT strings at synthesis" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1300" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="rf" value="&lt;b&gt;RegFileROM  #(DEPTH, WIDTH, INIT_FILE, RAM_STYLE)  — async read → LUTRAM / distributed RAM&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FAFAFA;strokeColor=#7A7A7A;rounded=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="620" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="rf_a" value="addr [⌈log2 DEPTH⌉]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="150" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="rf_m" value="&lt;b&gt;mem [DEPTH] × WIDTH&lt;/b&gt;&lt;br&gt;data = mem[addr]  (combinational, no clock, no enable)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="130" width="290" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="rf_d" value="data [WIDTH]&lt;br&gt;(same cycle)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="530" y="143" width="110" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="rf_n" value="Used for the small compiler regfiles read at a registered pc and consumed in the SAME cycle:&lt;br&gt;sync masks, kernel cores, output_sync, global_index, round_marker, postselect, MMIO instruction regfile." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="210" width="590" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sr" value="&lt;b&gt;SyncROM  #(DEPTH, WIDTH, INIT_FILE, RAM_STYLE)  — sync read, 1-cycle latency → block RAM&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FAFAFA;strokeColor=#7A7A7A;rounded=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="690" y="80" width="640" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="sr_a" value="en, addr" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="710" y="150" width="110" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sr_m" value="&lt;b&gt;BRAM read stage (pure, holds when !en)&lt;/b&gt;&lt;br&gt;if (en) mem_q ← mem[addr];  vld_q ← en&lt;br&gt;NO reset (models the BRAM output register)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sr_x" value="fabric mux&lt;br&gt;data = vld_q ? mem_q : 0" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="840" y="200" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="sr_d" value="data [WIDTH],&lt;br&gt;data_valid  (+1 cycle)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1180" y="150" width="130" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="sr_n" value="Used for large memories: the MMIO command-word memory&lt;br&gt;and StimReadout's recorded measurements." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1010" y="235" width="310" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="br" value="&lt;b&gt;BankedRAM  #(BANKS, DEPTH, WIDTH, RAM_STYLE)  — banked simple-dual-port RAM, synchronous read, READ_FIRST  (the PGE's M_T column store)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FAFAFA;strokeColor=#7A7A7A;rounded=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="320" width="1300" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="br_i" value="index → bank = index[log2 BANKS−1:0]&lt;br&gt;            offset = index[INDEX_W−1 : log2 BANKS]&lt;br&gt;(decode done by the CALLER: the compiler's relabelling&lt;br&gt; π(c) = offset·BANKS + bank makes the split fixed wiring)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F0EAFA;strokeColor=#5E35B1;rounded=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="br_b0" value="&lt;b&gt;bank 0&lt;/b&gt;&lt;br&gt;mem [DEPTH] × WIDTH&lt;br&gt;rd_en / rd_addr → rd_data (+1 cycle;&lt;br&gt;0 when rd_en was low)&lt;br&gt;wr_en / wr_addr / wr_data" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="370" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="br_b1" value="&lt;b&gt;bank 1&lt;/b&gt;&lt;br&gt;mem [DEPTH] × WIDTH&lt;br&gt;rd_en / rd_addr → rd_data (+1 cycle;&lt;br&gt;0 when rd_en was low)&lt;br&gt;wr_en / wr_addr / wr_data" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="370" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="br_b2" value="&lt;b&gt;bank BANKS−1&lt;/b&gt;&lt;br&gt;mem [DEPTH] × WIDTH&lt;br&gt;rd_en / rd_addr → rd_data (+1 cycle;&lt;br&gt;0 when rd_en was low)&lt;br&gt;wr_en / wr_addr / wr_data" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF4D6;strokeColor=#B07D00;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="370" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="br_dots" value="…" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="845" y="415" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="br_o" value="rd_data [BANKS × WIDTH]&lt;br&gt;→ consumer XOR tree takes all banks&lt;br&gt;unconditionally (rd_en is the mask)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fillColor=#FFFFFF;strokeColor=#555555;rounded=1;arcSize=50;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1090" y="380" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="br_n" value="Banking rule (enforced by the PGE compiler): for every fault at most one of its checks lands in any one bank, so all of a fault's columns&lt;br&gt;are readable in a single cycle. One read + one write port per bank. Async reset zeroes every bank (note: prevents BRAM inference — revisit for a real target)." style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="1260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="" style="html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#8A6D00;strokeWidth=1.3;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="rf_a" target="rf_m">
