        <mxCell id="cmn" value="core c occupies bits [c(N+1) +: N+1]:  bit N = emit, bits N−1..0 = select mask" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=none;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
