        </mxCell>
        <mxCell id="acc0" value="acc[0]  (1 bit)&lt;br&gt;← emit ? 0 : b_core" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#EDEDED;strokeColor=#1A1A1A;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
