+/* [MagiC-Firm patch] program per-layer arrival-offset table (pre-window) */
+void setup_load_stall_schedule(const uint32_t* offsets, uint16_t len, uint16_t context_id) {
+    Xil_Out32(UB_CONTEXT(context_id) + 88, 0);
+    for (uint16_t i = 0; i < len; i++) {
+        Xil_Out32(UB_CONTEXT(context_id) + 96, offsets[i]);
+    }
+    Xil_Out32(UB_CONTEXT(context_id) + 104, 1);
+}
+
 uint64_t get_last_load_time(uint16_t context_id) {
     return Xil_In64(UB_CONTEXT(context_id));
 }
