{
  "_README": {
    "about": "Compiler configuration for the detector-construction compiler. Two sections: 'hardware' (the tree of control boards; circuit-agnostic) and 'postselect' (how to classify postselect detectors; circuit/decoder-specific). Provide only physical facts + the postselect rule; the compiler derives the rest (measurement widths, detector in/out widths, channel placement, stage boards).",
    "name": "free-text name of this configuration",
    "version": "config format version (integer)",

    "hardware": "the board tree; contains 'layers'",
    "hardware.layers": "ordered list of board layers; level 0 = leaf layer (wired to qubits), last level = root",
    "hardware.layers[].level": "layer index; 0 for the leaf layer, increasing toward the root",
    "hardware.layers[].type": "board type in this layer: 'leaf' | 'router' | 'root'",
    "hardware.layers[].boards": "list of boards in this layer",
    "board_id": "globally-unique integer id for the board (unique across ALL layers)",
    "qubits": "[leaf only] every physical qubit index wired to this board (measured or not); the compiler keeps the ones actually measured into detectors",
    "children": "[router/root only] board_id list of the boards in the previous layer that feed this board",
    "kernels": "list of detector channels this board has; length = number of kernels (k)",
    "kernels[].n": "selector width: how many measurement lines this kernel may pick from the board's measurements",
    "kernels[].h": "number of cores in this kernel = how many detector time-indices it can build in parallel",
    "raw_out": "[leaf/router only] max number of raw (unconstructed) measurements this board may forward to its parent; root has none (endpoint)",

    "postselect": "WHICH detectors to postselect (fire => discard the shot): 'none', an explicit list of stim detector indices, or {'from_file': <json path>} reading the list from a JSON file (bare list, or dict whose 'postselected_detectors' key holds it; override the key via 'key'). Relative paths resolve against this config's directory.",
    "postselect_source": "the postselect set is a circuit+decoder property computed by the decoder workflow, not by a coordinate rule in the compiler — for cultivation circuits, algorithms/get_desaturated_dem_with_obs_detector.py writes postselected_detectors.json next to the circuit copy",

    "derived_not_here": "m (measurement inputs), detector in/out widths, raw inputs, each router/root's qubit scope, channel->kernel assignment, and per-stage postselect/matchable split are all derived by the compiler"
  },

